<Window x:Class="PianoTrainer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Piano Trainer" Height="350" Width="525">
    <Grid>
        <StackPanel Margin="10">
            <TextBlock Text="Press notes on your MIDI keyboard" FontSize="16"/>
            <ListBox x:Name="NoteList" Height="200"/>
        </StackPanel>
    </Grid>
</Window>
